# Production-style environment example for a controlled private pilot.
# Copy to your deployment secret manager or deployment environment variables.
# Do not commit real values. Do not use this file as a local plaintext secret store.

# ===== App mode =====
APP_ENV=production
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# ===== Security headers / CORS =====
# Set to exact HTTPS origins only. Do not use "*" in production.
CORS_ALLOWED_ORIGINS=https://pilot.example.com
SECURITY_HEADERS_ENABLED=true
# Restrict browser connections to the app itself and the approved pilot API origin.
CONTENT_SECURITY_POLICY="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api-pilot.example.com; form-action 'self'; upgrade-insecure-requests"

# ===== Auth/session secrets =====
# Provide unique high-entropy values through environment variables or a secret manager.
SECRET_KEY=replace-with-production-secret-from-secret-manager
AUTH_SECRET_KEY=replace-with-production-auth-secret-from-secret-manager
# 1800 seconds = 30 minutes.
AUTH_TOKEN_EXPIRY_SECONDS=1800
SETTINGS_PERSIST_SECRETS=false

# ===== Rate limiting =====
RATE_LIMIT_ENABLED=true
# App-level limiter remains local/process memory. Use edge/API-gateway or shared-store
# limiting before public internet exposure.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_DEMO_PER_WINDOW=60
RATE_LIMIT_STATUS_PER_WINDOW=60
RATE_LIMIT_DECISION_PER_WINDOW=60
RATE_LIMIT_SIMULATION_PER_WINDOW=30
RATE_LIMIT_TRUSTED_PROXIES=

# ===== Logging =====
REQUEST_BODY_LOGGING_ENABLED=false

# ===== LLM Provider =====
# Use environment variables or a secret manager for API keys.
LLM_PROVIDER=openai
LLM_MODEL_NAME=replace-with-approved-model
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-provider-key-from-secret-manager
LLM_TIMEOUT=600

# CAMEL-AI/OASIS OpenAI-compatible settings.
OPENAI_API_KEY=replace-with-provider-key-from-secret-manager
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ===== Embedding Provider =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-embedding-key-from-secret-manager

# ===== Graph Database =====
NEO4J_URI=neo4j+s://replace-with-approved-host.example
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-graph-password-from-secret-manager

# ===== Frontend =====
VITE_API_BASE_URL=https://pilot.example.com
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_DEBUG=false
