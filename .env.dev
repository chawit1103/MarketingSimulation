# =============================================================
# MiroFish MultiLang — Development Configuration
# =============================================================
# This is for the DEV stack only (docker-compose.dev.yml)
# Ports: Frontend 3001, Backend 5002, Neo4j 7475/7688
# =============================================================

# ===== LLM Configuration (Primary — choose your provider) =====
LLM_API_KEY=sk-placeholder
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# ===== Neo4j Configuration (Dev instance) =====
# For Docker: use service name "neo4j-dev"
NEO4J_URI=bolt://neo4j-dev:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofishdev

# ===== Embedding Configuration =====
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=http://localhost:11434

# ===== OASIS / CAMEL-AI Configuration =====
# Points to same cloud LLM
OPENAI_API_KEY=sk-placeholder
OPENAI_API_BASE_URL=https://api.deepseek.com/v1

# ===== Dev-specific =====
FLASK_DEBUG=True
LLM_TIMEOUT=600
