# =============================================================
# MiroFish MultiLang Configuration
# =============================================================
# Multi-provider simulation engine with English, Chinese, Hindi,
# Spanish, French, Arabic, Bengali, Portuguese, Russian, Urdu,
# and Thai UI support.
#
# Copy this file to .env and adjust values for your setup.
# All values can also be changed at runtime via the Settings UI.
# =============================================================

# ===== LLM Provider =====
# Options: ollama | openai | anthropic | google | deepseek | groq | openrouter
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen2.5:7b

# Provider-specific settings (only needed for the provider you choose):
# --- Ollama (default) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama     # any non-empty value works for Ollama

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL_NAME=claude-3-5-sonnet-20241022
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-...

# --- Google ---
# LLM_PROVIDER=google
# LLM_MODEL_NAME=gemini-2.0-flash
# LLM_API_KEY=...

# --- DeepSeek ---
# LLM_PROVIDER=deepseek
# LLM_MODEL_NAME=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...

# --- Groq ---
# LLM_PROVIDER=groq
# LLM_MODEL_NAME=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...

# --- OpenRouter ---
# LLM_PROVIDER=openrouter
# LLM_MODEL_NAME=openai/gpt-4o
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...

# ===== LLM Fine-tuning =====
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=600

# ===== Embedding Provider =====
# Options: ollama | openai | google | cohere
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=     # required for cloud providers

# --- OpenAI Embeddings ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...

# --- Google Embeddings ---
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_API_KEY=...

# ===== Graph Database =====
# Mode: local (Docker Neo4j) | cloud (AuraDB / self-hosted remote)
GRAPH_DB_MODE=local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# For cloud Neo4j (AuraDB):
# GRAPH_DB_MODE=cloud
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_aura_password

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Points to the same LLM provider as configured above
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# For cloud providers, match your LLM_PROVIDER settings:
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# ===== Language (UI language) =====
# Options: en | zh-CN | hi | es | fr | ar | bn | pt | ru | ur | th
LANGUAGE=en

# ===== Docker-mode overrides =====
# When running ALL services inside Docker via docker-compose.yml,
# the backend communicates with neo4j/ollama by their service names.
# Uncomment these for the production Docker stack:
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1

# When using docker-compose.dev.yml (cloud LLM only, no Ollama):
# NEO4J_URI=bolt://neo4j-dev:7687
# (LLM/Embedding URLs stay as cloud endpoints — Ollama is absent)
