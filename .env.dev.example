# Local development environment example.
# Copy this file to .env.dev for local use.
# Never commit .env.dev or any real API keys, passwords, tokens, or customer data.

# ===== App mode =====
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# ===== Auth/session secrets =====
# Use unique random local-only values. Replace before any shared environment.
SECRET_KEY=replace-with-local-dev-secret
AUTH_SECRET_KEY=replace-with-local-dev-auth-secret

# ===== LLM Provider =====
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama-local-placeholder

# CAMEL-AI/OASIS OpenAI-compatible settings.
OPENAI_API_KEY=ollama-local-placeholder
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Embedding Provider =====
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-neo4j-password

# ===== Runtime tuning =====
LLM_TIMEOUT=600
RATE_LIMIT_ENABLED=true
